// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 老师状态枚举git
enum TeacherStatus {
  NOT_STARTED // 未开始
  IN_PROGRESS // 引导中
  PENDING_REVIEW // 待审核
  COMPLETED // 已完成引导
  UNLOCKED // 已解锁接单
}

// 任务状态枚举
enum TaskStatus {
  NOT_STARTED // 未开始
  IN_PROGRESS // 进行中
  PENDING_FEEDBACK // 待反馈
  COMPLETED // 已完成
  NEEDS_REVISION // 需调整
}

// 任务类型枚举
enum TaskType {
  INFO // 了解信息
  FORM // 填写表单
  VIDEO_UPLOAD // 视频上传
  TRAINING // 观看培训
  ONLINE_TEST // 在线测试
}

// 邀请状态枚举
enum ReferralStatus {
  PENDING // 待审核（默认状态）
  VALID // 有效邀请
  INVALID // 无效邀请
}

// 邀请类型枚举
enum ReferralType {
  DIRECT // 直接邀请
  INDIRECT // 间接邀请
}

// 提现状态枚举
enum WithdrawalStatus {
  PENDING // 已申请
  APPROVED // 已成功
  REJECTED // 已驳回
}

// 学习规划师申请状态
enum LearningPlannerApplicationStatus {
  PENDING // 待审核
  APPROVED // 审核通过
  REJECTED // 审核不通过
}

// 学习规划师评审结论
enum LearningPlannerReviewDecision {
  APPROVED // 审核通过
  REJECTED // 审核不通过
}

// 授课状态枚举
enum TeachingStatus {
  NOT_TAUGHT // 未授课
  TAUGHT // 已授课
}

// 运营人员
model Operator {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  password     String   // bcrypt 加密
  isEnabled    Boolean  @default(true)  // 启用状态，false 则无法登录
  wechatQrCode String?  // 微信二维码图片 URL
  remarks      String?  // 备注

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamTeachers    TeacherTeam[]
  teacherRemarks  TeacherRemark[]
  plannerReviews  LearningPlannerReview[]

  @@index([phone])
  @@map("operators")
}

// 老师归属关系（每个老师只能属于一个运营人员）
model TeacherTeam {
  id         String   @id @default(cuid())
  teacherId  String   @unique
  operatorId String
  createdAt  DateTime @default(now())

  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@map("teacher_teams")
}

// 老师备注日志
model TeacherRemark {
  id         String   @id @default(cuid())
  teacherId  String
  operatorId String?  // 可空，允许管理员也能写备注
  remarkBy   String   // 备注人姓名
  content    String
  createdAt  DateTime @default(now())

  teacher  Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([operatorId])
  @@map("teacher_remarks")
}

// 老师信息
model Teacher {
  id String @id @default(cuid())

  // 基础信息（必填）
  name     String //姓名（必填）
  phone    String @unique // 联系电话（唯一，必填，用于登录）
  password String // 密码（bcrypt加密，必填，用于登录）

  // 基础信息（可选）
  gender         String? // 性别：男/女
  age            Int? // 年龄
  school         String? // 学历/学校（包含专业）
  graduationYear String? // 毕业年份
  identity       String? // 身份：在读学生/毕业生/其他

  // 学科信息
  subjects       String[] // 可教学科列表，如 ["MATH","PHYSICS"]
  primarySubject String?  // 最擅长学科，如 "PHYSICS"

  // 教学能力 & 资质
  mathScore          Int? // 高考数学成绩
  physicsScore       Int? // 高考物理成绩
  chemistryScore     Int? // 高考化学成绩
  mathCompetition    String? // 数学竞赛经历（旧字段，保留向下兼容）
  scienceCompetition String? // 数理化竞赛经历
  teachingExperience String? // 教学经验
  gradePreference    String? // 可辅导学段（多选，逗号分隔）
  teachingStrengths  String? // 擅长方向（多选，逗号分隔）
  teachingStyle      String? // 教学风格
  studentTypes       String? // 擅长学生类型（多选，逗号分隔）

  // 可辅导时间
  weekdayTime String? // 周一到周五
  weekendTime String? // 周末
  holidayTime String? // 寒暑假

  // 系统状态
  status           TeacherStatus @default(NOT_STARTED)
  currentPhase     Int           @default(1) // 当前阶段 1-3
  currentTaskIndex Int           @default(0) // 当前任务索引 0-5

  // 邀请相关
  inviteCode     String?        @unique // 唯一邀请码（用于分享给他人）
  invitedById    String? // 邀请人ID
  teachingStatus TeachingStatus @default(NOT_TAUGHT) // 授课状态

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  taskSubmissions   TaskSubmission[]
  invitedBy         Teacher?         @relation("TeacherReferrals", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedTeachers   Teacher[]        @relation("TeacherReferrals")
  referrals         Referral[]       @relation("ReferrerReferrals")
  referredReferrals Referral[]       @relation("ReferredReferrals")
  withdrawals       Withdrawal[]
  referralStats     ReferralStats?
  teamAssignment    TeacherTeam?
  remarks           TeacherRemark[]
  learningPlannerApplication LearningPlannerApplication?

  @@index([phone])
  @@index([currentTaskIndex])
  @@index([createdAt])
  @@map("teachers")
}

// 任务提交记录
model TaskSubmission {
  id        String     @id @default(cuid())
  teacherId String
  taskIndex Int // 任务索引 0-5
  taskType  TaskType
  status    TaskStatus @default(IN_PROGRESS)

  // 表单数据(JSON格式存储)
  formData Json?

  // 文本内容
  textContent String?

  // 培训视频观看进度
  watchProgress Int? @default(0) // 观看进度百分比

  // 审核反馈
  feedback   String?
  reviewedAt DateTime?
  reviewedBy String?

  // 提交次数
  attemptCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, taskIndex])
  @@index([teacherId])
  @@index([status])
  @@map("task_submissions")
}

// 任务配置表
model TaskConfig {
  id               String   @id @default(cuid())
  index            Int      @unique
  title            String
  phase            Int
  emoji            String
  type             TaskType
  description      String
  estimatedMinutes Int
  isOptional       Boolean  @default(false)
  requirements     Json // 存储字符串数组
  questions        Json? // 在线测试题目（ONLINE_TEST类型使用）
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_configs")
}

// 阶段配置表
model PhaseConfig {
  id          String  @id @default(cuid())
  phase       Int     @unique
  title       String
  description String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phase_configs")
}

// 邀请记录表
model Referral {
  id String @id @default(cuid())

  // 邀请关系
  referrerId String // 邀请人ID
  referredId String // 被邀请人ID

  // 邀请类型
  type               ReferralType @default(DIRECT) // 邀请类型：直接/间接
  indirectReferrerId String? // 间接邀请时的中间人ID（仅INDIRECT类型有值）

  // 状态管理
  status     ReferralStatus @default(PENDING) // 邀请状态
  rewardSent Boolean        @default(false) // 是否已发放奖励

  // 管理员操作
  adminNote  String? // 管理员备注（如标记无效的理由）
  reviewedBy String? // 审核人
  reviewedAt DateTime? // 审核时间

  // 授课相关
  lessonNote String? // 授课备注
  verifiedBy String? // 授课审核人
  verifiedAt DateTime? // 授课审核时间

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  referrer Teacher @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Teacher @relation("ReferredReferrals", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId, type]) // 同一个人对同一个被邀请人只能有一种邀请类型
  @@index([referrerId])
  @@index([referredId])
  @@index([status])
  @@index([type])
  @@index([indirectReferrerId])
  @@map("referrals")
}

// 提现申请表
model Withdrawal {
  id String @id @default(cuid())

  // 提现人信息
  teacherId String // 申请提现的老师ID

  // 提现金额
  amount Float // 提现金额（元）

  // 银行账户信息
  accountName String // 账户名称（姓名）
  bankName    String // 开户行名称
  cardNumber  String // 银行卡号
  phone       String // 手机号
  idCard      String // 身份证号码

  // 状态管理
  status WithdrawalStatus @default(PENDING) // 提现状态

  // 管理员操作
  rejectNote String? // 驳回备注
  reviewedBy String? // 审核人
  reviewedAt DateTime? // 审核时间

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

// 学习规划师资格认证申请
model LearningPlannerApplication {
  id        String                           @id @default(cuid())
  teacherId String                           @unique
  status    LearningPlannerApplicationStatus @default(PENDING)

  studyPlanPdfUrl   String
  studyPlanPdfName  String
  trialLessonVideoUrl String
  statement         String

  approveCount      Int      @default(0)
  rejectCount       Int      @default(0)
  finalDecisionNote String?

  submittedAt     DateTime @default(now())
  finalReviewedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reviews LearningPlannerReview[]

  @@index([status])
  @@index([submittedAt])
  @@map("learning_planner_applications")
}

// 学习规划师资格认证评审记录
model LearningPlannerReview {
  id            String                        @id @default(cuid())
  applicationId String
  operatorId    String
  decision      LearningPlannerReviewDecision
  reason        String?
  imageUrls     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application LearningPlannerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  operator    Operator                   @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([applicationId, operatorId])
  @@index([applicationId])
  @@index([operatorId])
  @@index([decision])
  @@map("learning_planner_reviews")
}

// 系统配置表
model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique // 配置键（如 'DIRECT_REWARD', 'INDIRECT_REWARD'）
  value String // 配置值

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

// 邀请统计表
model ReferralStats {
  id        String @id @default(cuid())
  teacherId String @unique // 老师ID

  // 直接邀请统计
  directTotal   Int @default(0) // 直接邀请总数
  directValid   Int @default(0) // 有效直接邀请数
  directPending Int @default(0) // 待审核直接邀请数
  directInvalid Int @default(0) // 无效直接邀请数
  directTaught  Int @default(0) // 直接邀请完成授课数

  // 间接邀请统计
  indirectTotal   Int @default(0) // 间接邀请总数
  indirectValid   Int @default(0) // 有效间接邀请数
  indirectPending Int @default(0) // 待审核间接邀请数
  indirectInvalid Int @default(0) // 无效间接邀请数
  indirectTaught  Int @default(0) // 间接邀请完成授课数

  // 收益统计
  totalEarnings     Float @default(0) // 总收益（元）
  totalWithdrawn    Float @default(0) // 已提现金额（元）
  pendingWithdrawal Float @default(0) // 待审核提现金额（元）
  availableBalance  Float @default(0) // 可提现余额（元）

  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  // 关系
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("referral_stats")
}
