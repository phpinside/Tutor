// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 老师状态枚举git
enum TeacherStatus {
  NOT_STARTED // 未开始
  IN_PROGRESS // 引导中
  PENDING_REVIEW // 待审核
  COMPLETED // 已完成引导
  UNLOCKED // 已解锁接单
}

// 任务状态枚举
enum TaskStatus {
  NOT_STARTED // 未开始
  IN_PROGRESS // 进行中
  PENDING_FEEDBACK // 待反馈
  COMPLETED // 已完成
  NEEDS_REVISION // 需调整
}

// 任务类型枚举
enum TaskType {
  INFO // 了解信息
  FORM // 填写表单
  VIDEO_UPLOAD // 视频上传
  TRAINING // 观看培训
  ONLINE_TEST // 在线测试
}

// 邀请状态枚举
enum ReferralStatus {
  PENDING // 待审核（默认状态）
  VALID // 有效邀请
  INVALID // 无效邀请
}

// 邀请类型枚举
enum ReferralType {
  DIRECT // 直接邀请
  INDIRECT // 间接邀请
}

// 提现状态枚举
enum WithdrawalStatus {
  PENDING // 已申请
  APPROVED // 已成功
  REJECTED // 已驳回
}

// 学习规划师申请状态
enum LearningPlannerApplicationStatus {
  PENDING // 待审核
  APPROVED // 审核通过
  REJECTED // 审核不通过
}

// 学习规划师评审结论
enum LearningPlannerReviewDecision {
  APPROVED // 审核通过
  REJECTED // 审核不通过
}

// 教练审核阶段
enum CoachReviewStage {
  FIRST_REVIEW // 待初审（或合并审核）
  FINAL_REVIEW // 待复审（初审已通过）
  APPROVED // 终审通过
  REJECTED // 已驳回，等待教练修改
}

// 单次审核结论
enum ReviewVerdict {
  PENDING // 待处理
  APPROVED // 通过
  REJECTED // 驳回
  SKIPPED // 跳过（合并审核 / 超管越级终审）
}

// 授课状态枚举
enum TeachingStatus {
  NOT_TAUGHT // 未授课
  TAUGHT // 已授课
}

// 腾讯会议预约状态；进行中/已结束根据预约时间动态计算
enum TencentMeetingBookingStatus {
  SCHEDULED
  CANCELLED
}

// 腾讯会议预约创建人员类型；历史老师预约也保留在共享列表中
enum TencentMeetingCreatorType {
  TEACHER
  OPERATOR
  ADMIN
}

// 运营人员
model Operator {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  password     String   // bcrypt 加密
  isEnabled    Boolean  @default(true)  // 启用状态，false 则无法登录
  wechatQrCode String?  // 微信二维码图片 URL
  remarks      String?  // 备注

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamTeachers            TeacherTeam[]
  teacherRemarks          TeacherRemark[]
  plannerReviews          LearningPlannerReview[]
  inviterDefaultFollowUps Teacher[]               @relation("InviterDefaultFollowUp")

  @@index([phone])
  @@map("operators")
}

// 老师归属关系（每个老师只能属于一个运营人员）
model TeacherTeam {
  id         String   @id @default(cuid())
  teacherId  String   @unique
  operatorId String
  createdAt  DateTime @default(now())

  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@map("teacher_teams")
}

// 老师备注日志
model TeacherRemark {
  id         String   @id @default(cuid())
  teacherId  String
  operatorId String?  // 可空，允许管理员也能写备注
  remarkBy   String   // 备注人姓名
  content    String
  createdAt  DateTime @default(now())

  teacher  Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([operatorId])
  @@map("teacher_remarks")
}

// 老师信息
model Teacher {
  id String @id @default(cuid())

  // 基础信息（必填）
  name     String //姓名（必填）
  phone    String @unique // 联系电话（唯一，必填，用于登录）
  password String // 密码（bcrypt加密，必填，用于登录）

  // 基础信息（可选）
  gender         String? // 性别：男/女
  age            Int? // 年龄
  school         String? // 学历/学校（包含专业）
  graduationYear String? // 毕业年份
  identity       String? // 身份：在读学生/毕业生/其他

  // 学科信息
  subjects       String[] // 可教学科列表，如 ["MATH","PHYSICS"]
  primarySubject String?  // 最擅长学科，如 "PHYSICS"

  // 教学能力 & 资质
  mathScore          Int? // 高考数学成绩
  physicsScore       Int? // 高考物理成绩
  chemistryScore     Int? // 高考化学成绩
  mathCompetition    String? // 数学竞赛经历（旧字段，保留向下兼容）
  scienceCompetition String? // 数理化竞赛经历
  teachingExperience String? // 教学经验
  gradePreference    String? // 可辅导学段（多选，逗号分隔）
  teachingStrengths  String? // 擅长方向（多选，逗号分隔）
  teachingStyle      String? // 教学风格
  studentTypes       String? // 擅长学生类型（多选，逗号分隔）

  // 可辅导时间
  weekdayTime String? // 周一到周五
  weekendTime String? // 周末
  holidayTime String? // 寒暑假

  // 系统状态
  status           TeacherStatus @default(NOT_STARTED)
  currentPhase     Int           @default(1) // 当前阶段 1-3
  currentTaskIndex Int           @default(0) // 当前任务索引 0-5

  // 邀请相关
  inviteCode               String?        @unique // 唯一邀请码（用于分享给他人）
  invitedById              String? // 邀请人ID
  teachingStatus           TeachingStatus @default(NOT_TAUGHT) // 授课状态
  defaultInviteeFollowUpId String? // 被邀请人默认跟进人（运营ID），仅对新注册有效

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  taskSubmissions          TaskSubmission[]
  invitedBy                Teacher?         @relation("TeacherReferrals", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedTeachers          Teacher[]        @relation("TeacherReferrals")
  referrals                Referral[]       @relation("ReferrerReferrals")
  referredReferrals        Referral[]       @relation("ReferredReferrals")
  withdrawals              Withdrawal[]
  referralStats            ReferralStats?
  teamAssignment           TeacherTeam?
  remarks                  TeacherRemark[]
  learningPlannerApplication LearningPlannerApplication?
  defaultInviteeFollowUp   Operator?        @relation("InviterDefaultFollowUp", fields: [defaultInviteeFollowUpId], references: [id], onDelete: SetNull)
  plannerCheckRecords      PlannerCheckRecord[]
  internshipCertificateDraft InternshipCertificateDraft?
  coachReview              CoachReview?
  tencentMeetingBookings   TencentMeetingBooking[]

  @@index([phone])
  @@index([currentTaskIndex])
  @@index([createdAt])
  @@map("teachers")
}

// 任务提交记录
model TaskSubmission {
  id        String     @id @default(cuid())
  teacherId String
  taskIndex Int // 任务索引 0-5
  taskType  TaskType
  status    TaskStatus @default(IN_PROGRESS)

  // 表单数据(JSON格式存储)
  formData Json?

  // 文本内容
  textContent String?

  // 培训视频观看进度
  watchProgress Int? @default(0) // 观看进度百分比

  // 审核反馈
  feedback   String?
  reviewedAt DateTime?
  reviewedBy String?

  // 提交次数
  attemptCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, taskIndex])
  @@index([teacherId])
  @@index([status])
  @@map("task_submissions")
}

// 任务配置表
model TaskConfig {
  id               String   @id @default(cuid())
  index            Int      @unique
  title            String
  phase            Int
  emoji            String
  type             TaskType
  description      String
  estimatedMinutes Int
  isOptional       Boolean  @default(false)
  requirements     Json // 存储字符串数组
  questions        Json? // 在线测试题目（ONLINE_TEST类型使用）
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_configs")
}

// 阶段配置表
model PhaseConfig {
  id          String  @id @default(cuid())
  phase       Int     @unique
  title       String
  description String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phase_configs")
}

// 邀请记录表
model Referral {
  id String @id @default(cuid())

  // 邀请关系
  referrerId String // 邀请人ID
  referredId String // 被邀请人ID

  // 邀请类型
  type               ReferralType @default(DIRECT) // 邀请类型：直接/间接
  indirectReferrerId String? // 间接邀请时的中间人ID（仅INDIRECT类型有值）

  // 状态管理
  status     ReferralStatus @default(PENDING) // 邀请状态
  rewardSent Boolean        @default(false) // 是否已发放奖励

  // 管理员操作
  adminNote  String? // 管理员备注（如标记无效的理由）
  reviewedBy String? // 审核人
  reviewedAt DateTime? // 审核时间

  // 授课相关
  lessonNote String? // 授课备注
  verifiedBy String? // 授课审核人
  verifiedAt DateTime? // 授课审核时间

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  referrer Teacher @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred Teacher @relation("ReferredReferrals", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId, type]) // 同一个人对同一个被邀请人只能有一种邀请类型
  @@index([referrerId])
  @@index([referredId])
  @@index([status])
  @@index([type])
  @@index([indirectReferrerId])
  @@map("referrals")
}

// 提现申请表
model Withdrawal {
  id String @id @default(cuid())

  // 提现人信息
  teacherId String // 申请提现的老师ID

  // 提现金额
  amount Float // 提现金额（元）

  // 银行账户信息
  accountName String // 账户名称（姓名）
  bankName    String // 开户行名称
  cardNumber  String // 银行卡号
  phone       String // 手机号
  idCard      String // 身份证号码

  // 状态管理
  status WithdrawalStatus @default(PENDING) // 提现状态

  // 管理员操作
  rejectNote String? // 驳回备注
  reviewedBy String? // 审核人
  reviewedAt DateTime? // 审核时间

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

// 学习规划师资格认证申请
model LearningPlannerApplication {
  id        String                           @id @default(cuid())
  teacherId String                           @unique
  status    LearningPlannerApplicationStatus @default(PENDING)

  studyPlanPdfUrl   String
  studyPlanPdfName  String
  trialLessonVideoUrl String
  statement         String

  approveCount      Int      @default(0)
  rejectCount       Int      @default(0)
  finalDecisionNote String?

  submittedAt     DateTime @default(now())
  finalReviewedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reviews LearningPlannerReview[]

  @@index([status])
  @@index([submittedAt])
  @@map("learning_planner_applications")
}

// 学习规划师资格认证评审记录
model LearningPlannerReview {
  id            String                        @id @default(cuid())
  applicationId String
  operatorId    String
  decision      LearningPlannerReviewDecision
  reason        String?
  imageUrls     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application LearningPlannerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  operator    Operator                   @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([applicationId, operatorId])
  @@index([applicationId])
  @@index([operatorId])
  @@index([decision])
  @@map("learning_planner_reviews")
}

// 规划书自查状态枚举
enum PlannerCheckStatus {
  PENDING     // 待处理
  PROCESSING  // 分析中
  COMPLETED   // 已完成
  FAILED      // 失败
}

// 实习证明开具状态
enum InternshipCertificateDraftStatus {
  PROCESSING
  COMPLETED
  ISSUED
  REJECTED
  FAILED
}

// 实习证明模板来源：系统默认模板（表单生成）或自定义模板（用户上传 PDF）
enum InternshipCertificateTemplateMode {
  SYSTEM
  CUSTOM
}

// 实习证明申请（每位老师仅保留一条）
model InternshipCertificateDraft {
  id             String                           @id @default(cuid())
  teacherId      String                           @unique
  name           String?
  gender         String?
  idCard         String?
  startDate      DateTime?
  endDate        DateTime?
  companyName    String                           @default("北京一生二科技有限公司")
  templateMode   InternshipCertificateTemplateMode @default(SYSTEM)
  status         InternshipCertificateDraftStatus @default(PROCESSING)
  pdfKey         String?
  officialPdfKey String?
  errorMsg       String?
  rejectionReason String?
  createdAt      DateTime                         @default(now())
  completedAt    DateTime?
  issuedAt       DateTime?
  rejectedAt     DateTime?
  updatedAt      DateTime                         @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("internship_certificate_drafts")
}

// 规划书自查记录
model PlannerCheckRecord {
  id            String             @id @default(cuid())
  teacherId     String
  fileName      String
  extractedText String             @db.Text
  status        PlannerCheckStatus @default(PENDING)
  result        String?            @db.Text  // JSON: { issues, suggestions }
  errorMsg      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
  @@map("planner_check_records")
}

// 通过共享腾讯会议账号创建的预约记录
model TencentMeetingBooking {
  id                String                      @id @default(cuid())
  teacherId         String?
  creatorType       TencentMeetingCreatorType   @default(ADMIN)
  creatorId         String?
  creatorName       String                      @default("管理员")
  meetingId         String                      @unique
  meetingCode       String
  subject           String
  startTime         DateTime
  endTime           DateTime
  joinUrl           String
  meetingPassword   String?
  status            TencentMeetingBookingStatus @default(SCHEDULED)
  meetingRecordId   String?
  recordingUrl      String?
  recordingPassword String?
  recordingSyncedAt DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([teacherId, startTime])
  @@index([creatorType, creatorId])
  @@index([status, endTime])
  @@map("tencent_meeting_bookings")
}

// 教练两级审核记录
model CoachReview {
  id        String   @id @default(cuid())
  teacherId String   @unique // 被审核教练，一人一条

  // 初审
  firstReviewOperatorId String?                 // 初审运营ID；null = 合并审核（未走成两级）
  firstReviewVerdict    ReviewVerdict @default(PENDING)
  firstReviewedBy       String?                 // 初审人标识（operatorId）
  firstReviewedAt       DateTime?
  firstReviewNote       String?      @db.Text

  // 复审（固定由超管，无需指定 operatorId）
  finalReviewVerdict    ReviewVerdict @default(PENDING)
  finalReviewedBy       String?                 // 复审人标识
  finalReviewedAt       DateTime?
  finalReviewNote       String?      @db.Text

  // 整体状态
  stage       CoachReviewStage @default(FIRST_REVIEW)
  attemptCount Int             @default(1)      // 返工轮次

  // 学管解析记录
  resolvedManagerPhone String?                  // API 返回的学管手机号
  resolveSource        String?                  // 'api' | 'inviter_chain' | 'merged' | 'team_assignment' | 'random_assignment'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([stage])
  @@index([firstReviewOperatorId])
  @@map("coach_reviews")
}

// 系统配置表
model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique // 配置键（如 'DIRECT_REWARD', 'INDIRECT_REWARD'）
  value String // 配置值

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

// 邀请统计表
model ReferralStats {
  id        String @id @default(cuid())
  teacherId String @unique // 老师ID

  // 直接邀请统计
  directTotal   Int @default(0) // 直接邀请总数
  directValid   Int @default(0) // 有效直接邀请数
  directPending Int @default(0) // 待审核直接邀请数
  directInvalid Int @default(0) // 无效直接邀请数
  directTaught  Int @default(0) // 直接邀请完成授课数

  // 间接邀请统计
  indirectTotal   Int @default(0) // 间接邀请总数
  indirectValid   Int @default(0) // 有效间接邀请数
  indirectPending Int @default(0) // 待审核间接邀请数
  indirectInvalid Int @default(0) // 无效间接邀请数
  indirectTaught  Int @default(0) // 间接邀请完成授课数

  // 收益统计
  totalEarnings     Float @default(0) // 总收益（元）
  totalWithdrawn    Float @default(0) // 已提现金额（元）
  pendingWithdrawal Float @default(0) // 待审核提现金额（元）
  availableBalance  Float @default(0) // 可提现余额（元）

  lastUpdated DateTime @updatedAt
  createdAt   DateTime @default(now())

  // 关系
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("referral_stats")
}
