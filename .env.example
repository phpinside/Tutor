DATABASE_URL="postgresql://user:password@localhost:5432/tutor_onboarding?schema=public"
# 站点域名和协议自动从当前请求读取，无需配置 APP_URL。
PORT=3000
# 服务端日志文件路径（相对项目根目录或绝对路径，默认 logs/app.log）
LOG_FILE="logs/app.log"

QINIU_ACCESS_KEY=""
QINIU_SECRET_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
EXTERNAL_TUTOR_API_URL=""
EXTERNAL_TUTOR_API_TOKEN=""
EXTERNAL_MANAGER_API_URL=""

# 腾讯会议 AI Skill 专区获取；仅配置在服务端，严禁使用 NEXT_PUBLIC_ 前缀
TENCENT_MEETING_TOKEN=""
# 可选，通常无需修改
TENCENT_MEETING_MCP_URL="https://mcp.meeting.tencent.com/mcp/wemeet-open/v1"
TENCENT_MEETING_SKILL_VERSION="v1.0.14"

# ===== 超管凭据（P0：不再硬编码在源码中）=====
# 首次登录时迁入统一账号；迁入后修改密码请使用 /account，本配置不能覆盖数据库账号。
# 登录账号（默认 admin；不能与教练或学管手机号冲突）
ADMIN_USERNAME="admin"
# 推荐：bcrypt 哈希。生成方式：node -e "console.log(require('bcryptjs').hashSync('你的强密码',10))"
ADMIN_PASSWORD_HASH=""
# 兜底：明文口令（未配置 HASH 时使用；两者都未配置则禁止首次管理员登录）
ADMIN_PASSWORD=""

# 接单系统（eduflow）分数同步推送：教练高考分数变更后推送给 eduflow 展示页
EDUFLOW_SCORE_SYNC_URL="https://flowapi.chulu.net/v1/external/coach-scores/sync"
EDUFLOW_SCORE_SYNC_TOKEN="<与 eduflow EXTERNAL_API_TOKEN 相同>"
# EDU（接单系统）注册页地址：完成页"注册接单系统"引导卡使用；留空则不显示直达链接
EDU_REGISTER_URL="https://manager.chulu.net/register/tutor"
